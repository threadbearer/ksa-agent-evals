# Gemini key for the simulated caller and the judge (GOOGLE_API_KEY also works).
GEMINI_API_KEY=

# The agent under test. Default is the local bridge in the Knight Shift repo
# (npx tsx scripts/evals/agent-bridge.ts), which speaks the /api/chat contract.
AGENT_URL=http://127.0.0.1:8787/chat

CALLER_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
